      "title": "Flatliner: which marker corner?",
      "links": [],
      "rules": [
        {
          "text": "Toxic Friends and Kindred use nearly the same Flatliner strat; the only difference is where prey stands on a static marker.",
          "scenarios": []
        },
        {
          "text": "Check whether your marker set puts prey on the INSIDE or the OUTSIDE corner of the marker, and ask your PF lead which set they placed.",
          "scenarios": []
        }
      ]
