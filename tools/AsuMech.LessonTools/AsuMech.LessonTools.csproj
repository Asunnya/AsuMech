<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lesson authoring CLI. Reuses the test harness (ScenarioRun, fakes, datamining sheets) to run
       strats headless, so it references the test project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AsuMech.LessonTools</RootNamespace>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)/</DalamudLibPath>
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../AsuMech/AsuMech.csproj" />
    <ProjectReference Include="../../tests/AsuMech.Tests/AsuMech.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)Dalamud.dll" Private="true" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)Dalamud.Bindings.ImGui.dll" Private="true" />
    <Reference Include="Dalamud.Bindings.ImPlot" HintPath="$(DalamudLibPath)Dalamud.Bindings.ImPlot.dll" Private="true" />
    <Reference Include="Dalamud.Bindings.ImGuizmo" HintPath="$(DalamudLibPath)Dalamud.Bindings.ImGuizmo.dll" Private="true" />
    <Reference Include="FFXIVClientStructs" HintPath="$(DalamudLibPath)FFXIVClientStructs.dll" Private="true" />
    <Reference Include="InteropGenerator.Runtime" HintPath="$(DalamudLibPath)InteropGenerator.Runtime.dll" Private="true" />
    <Reference Include="Newtonsoft.Json" HintPath="$(DalamudLibPath)Newtonsoft.Json.dll" Private="true" />
    <Reference Include="Lumina" HintPath="$(DalamudLibPath)Lumina.dll" Private="true" />
    <Reference Include="Lumina.Excel" HintPath="$(DalamudLibPath)Lumina.Excel.dll" Private="true" />
    <Reference Include="Serilog" HintPath="$(DalamudLibPath)Serilog.dll" Private="true" />
    <Reference Include="Microsoft.Extensions.ObjectPool" HintPath="$(DalamudLibPath)Microsoft.Extensions.ObjectPool.dll" Private="true" />
  </ItemGroup>

  <Import Project="../../tests/AsuMech.Tests/Datamining.targets" />
</Project>
