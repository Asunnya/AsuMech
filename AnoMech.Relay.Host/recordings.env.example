# ANOMECH_RELAY_TOKEN: the value of DefaultRecordingsRelay.Token in the plugin build you ship.
# ANOMECH_RELAY_ADMIN_TOKEN: yours, for listing and downloading; at least 16 characters.
ANOMECH_RELAY_TOKEN=replace-with-DefaultRecordingsRelay.Token
ANOMECH_RELAY_ADMIN_TOKEN=replace-with-your-own-admin-token
